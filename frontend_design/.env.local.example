# Next.js 前端环境变量
# 复制此文件为 .env.local 并填入值

# 后端 API 地址 — 推荐统一接入 Go 网关 (8080)；直连 Python 后端则改为 http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8080

# 自动认证配置 — 开发环境下自动获取 JWT Token 的默认用户和密码
# 必须与后端 .env 中 RBAC_USER_PASSWORD 保持一致
NEXT_PUBLIC_DEFAULT_USER=nexus_dev
NEXT_PUBLIC_DEFAULT_PASSWORD=cockpit_user_2026

# WebSocket 地址 (预留配置，当前前端未使用 WS，聊天走 SSE /chat/stream)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/dataplatform/ws/realtime

# 注意: 复制此文件为 .env.local 后，请确保 NEXT_PUBLIC_DEFAULT_PASSWORD
# 与后端 .env 中的 RBAC_USER_PASSWORD 值一致，否则自动登录会返回 401
