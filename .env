# ============================================================
# NexusCockpit 统一默认配置 (.env)
# ------------------------------------------------------------
# 此文件提交到 GitHub, 包含开箱即用的默认值。
# 开发者克隆后无需修改即可启动 (docker compose up -d)。
#
# 如需覆盖默认值 (如切换 API Key、开启 DEBUG), 复制为 .env.local:
#   cp .env .env.local  然后在 .env.local 中修改
#
# 加载优先级 (config.py):
#   .env.local 存在 → 加载 .env.local (覆盖 .env)
#   .env.local 不存在 → 加载 .env (默认)
# ============================================================

# ============================================================
# LLM 配置
# ============================================================
# cloud = 云端 API (硅基流动) | local = 本地 llama.cpp
LLM_PROVIDER=cloud
ARK_API_KEY=sk-lexlgbwynianixnscmahjsnqwacatjbukhxtfddjdshmzfrc
ARK_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=local

# --- 本地 LLM 降级 (可选, 云端失败时自动切换) ---
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_BASE_URL=http://127.0.0.1:8082/v1
LLM_FALLBACK_MODEL=qwen3.5-4b-local
LLM_FALLBACK_TIMEOUT=60

# --- llama.cpp 子进程 (LLM_FALLBACK_ENABLED=true 时生效) ---
LLAMA_CPP_SUBPROCESS=true
LLAMA_CPP_BINARY=./models/llm/llama.cpp/llama-server
LLAMA_CPP_MODEL_PATH=./models/llm/qwen/Qwen3.5-4B-Q4_K_M.gguf
LLAMA_CPP_PORT=8082
LLAMA_CPP_HOST=127.0.0.1
LLAMA_CPP_CTX_SIZE=4096
LLAMA_CPP_GPU_LAYERS=-1
LLAMA_CPP_THREADS=8

# ============================================================
# 中间件配置 (本地 Docker 默认地址)
# ============================================================
# --- Milvus (向量数据库) ---
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_FOOD=Food_List
MILVUS_COLLECTION_MEMORY=User_Memory

# --- Neo4j (知识图谱) ---
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexuscockpit

# --- Redis (缓存+限流+PubSub) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=redis_secure_password_2026
REDIS_DB=0

# --- MySQL (用户数据+审计日志) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=nexuscockpit
MYSQL_DATABASE=nexus_cockpit

# --- Tavily (联网搜索) ---
TAVILY_API_KEY=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

# --- Langfuse (LLM 追踪, 可选, 不填则禁用) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://127.0.0.1:3101
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_NEXTAUTH_SECRET=changeme-langfuse-secret
LANGFUSE_SALT=changeme-langfuse-salt

# ============================================================
# 认证配置
# ============================================================
JWT_SECRET_KEY=nexuscockpit_secret_key_2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Go 网关 JWT (留空则自动复用 JWT_SECRET_KEY)
JWT_EXPIRE_HOURS=24

# RBAC 权限
RBAC_DEFAULT_ROLE=cockpit_user
RBAC_ADMIN_USERNAME=admin
RBAC_ADMIN_PASSWORD=admin123
RBAC_USER_PASSWORD=cockpit_user_2026

# CORS 跨域
CORS_ORIGINS=http://localhost:3000

# ============================================================
# 服务配置
# ============================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
SESSION_LOCKS_MAX=500
SSE_HEARTBEAT_INTERVAL=15.0

# --- 语义缓存 ---
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
SEMANTIC_CACHE_TTL_SECONDS=3600

# --- LLM 调用优化 ---
REFLECTION_ENABLED=true
MEMORY_EXTRACTION_ENABLED=true

# ============================================================
# 部署模式 (本地化降级后固定 local)
# ============================================================
VECTOR_STORE_PROVIDER=local
GRAPH_STORE_PROVIDER=local
CACHE_PROVIDER=local
RERANKER_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ============================================================
# 车辆总线
# ============================================================
VEHICLE_ADAPTER=mock

# --- 高德地图 (可选, 不填降级到 Nominatim) ---
AMAP_KEY=337b390e1467bfb2b7e080998b32091e

# ============================================================
# 第三方服务密钥
# ============================================================
# 美团开发者平台 (AI Hub 通用技能 + meituan-travel 旅行技能)
# 申请: https://developer.meituan.com/zh/v2/dev/aiHub/skillManage
MEITUAN_DEV_TOKEN=8e4e25b4bad3f27e7e173b9ebcae44562da90f10152dabb0a178ddf6d1e021b0
MEITUAN_HT_TOKEN=8e4e25b4bad3f27e7e173b9ebcae44562da90f10152dabb0a178ddf6d1e021b0

# 和风天气 API (天气查询服务)
# 申请: https://dev.qweather.com/
QWEATHER_PROJECT_ID=4GKRFDBBYN
QWEATHER_CREDENTIAL_ID=TDWGVNGVUM
QWEATHER_APIKEY=d6bf4a4b45604f4fb3656dc0142b863b
QWEATHER_KEY=d6bf4a4b45604f4fb3656dc0142b863b

# ============================================================
# 模型路径 (相对项目根目录)
# ============================================================
FUNASR_MODEL_PATH=./models/asr/sensevoice
CAM_MODEL_PATH=./models/sv/cam_plus
COSYVOICE_MODEL_PATH=./models/tts/cosyvoice

# --- 说话人验证音频目录 ---
SPEAKER_ENROLL_DIR=./assets/speaker/enroll_wav
SPEAKER_USERS_DIR=./assets/speaker/users

# ============================================================
# 数据目录 (相对项目根目录)
# ============================================================
FOOD_DATA_DIR=./data/food
KNOWLEDGE_DATA_DIR=./data/knowledge
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/temp
PREFERENCES_DIR=./data/preferences

# ============================================================
# 座舱配置
# ============================================================
COCKPIT_COUNT=1
COCKPIT_THEMES=#4fc3f7,#66bb6a,#ab47bc
COCKPIT_NAMES=座舱1,座舱2,座舱3

# ============================================================
# Go 网关 (NexusGate)
# ============================================================
NEXUS_GATE_HOST=0.0.0.0
NEXUS_GATE_PORT=8080
NEXUS_AI_HOST=127.0.0.1
NEXUS_AI_PORT=8000
NEXUS_GATE_MODE=proxy
RATE_LIMIT_QPS=100

# --- 声纹 ---
VOICEPRINT_MODEL=cam_plus
VOICEPRINT_THRESHOLD=0.7
VOICEPRINT_ENROLL_COUNT=3

# --- 可观测性 ---
PROMETHEUS_URL=http://127.0.0.1:9200

# ============================================================
# Docker 中间件默认密码 (docker-compose.yml 中通过 ${} 引用)
# ============================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================================
# 智能上下文记忆管理
# ============================================================
MEMORY_COMPRESS_THRESHOLD_TURNS=8
MEMORY_KEEP_RECENT_TURNS=5
MEMORY_MAX_SUMMARY_CHARS=1000
MEMORY_MAX_HISTORY_LEN=20
MEMORY_CONTEXT_TOKEN_RATIO=0.7
MEMORY_CONTEXT_TOKEN_HARD_CAP=4096

# ============================================================
# Checkpoint 持久化
# ============================================================
CHECKPOINT_PROVIDER=sqlite
